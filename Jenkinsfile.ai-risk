pipeline {
    agent any

    parameters {
        string(
            name: 'BASE_BRANCH',
            defaultValue: 'master',
            description: '用于生成 diff 的基线分支，例如 master 或 main'
        )
        choice(
            name: 'AI_PROVIDER',
            choices: ['MOCK', 'OPENAI_COMPATIBLE'],
            description: 'MOCK 只生成本地规则报告；OPENAI_COMPATIBLE 调用兼容 /v1/chat/completions 的模型服务'
        )
        string(
            name: 'AI_API_BASE',
            defaultValue: 'https://api.deepseek.com',
            description: 'AI 服务地址，不需要包含 /v1/chat/completions'
        )
        string(
            name: 'AI_MODEL_NAME',
            defaultValue: 'deepseek-v4-pro',
            description: 'AI 模型名称'
        )
        string(
            name: 'AI_CREDENTIALS_ID',
            defaultValue: 'AI_API_KEY',
            description: 'Jenkins Secret text 凭据 ID'
        )
        booleanParam(
            name: 'FAIL_ON_AI_ERROR',
            defaultValue: false,
            description: '远程 AI 调用失败时是否让构建失败'
        )
        booleanParam(
            name: 'COVERAGE_GATE_STRICT',
            defaultValue: false,
            description: '覆盖率未达标时是否失败；关闭时仅标记 unstable'
        )
        string(
            name: 'LINE_COVERAGE_MIN',
            defaultValue: '0.50',
            description: 'JaCoCo 行覆盖率门禁，例如 0.50'
        )
        string(
            name: 'BRANCH_COVERAGE_MIN',
            defaultValue: '0.30',
            description: 'JaCoCo 分支覆盖率门禁，例如 0.30'
        )
        string(
            name: 'EMAIL_TO',
            defaultValue: 'imacaiy@gmail.com',
            description: '构建完成后通知邮箱；留空则不发送邮件'
        )
        string(
            name: 'EMAIL_FROM',
            defaultValue: '',
            description: '可选：邮件发件人；留空则使用 Jenkins Email Extension 全局默认发件人'
        )
        string(
            name: 'JDK_TOOL_NAME',
            defaultValue: '',
            description: '可选：Jenkins 全局工具配置里的 JDK17 名称，例如 jdk17；留空则自动探测或使用当前 JAVA_HOME'
        )
        string(
            name: 'JDK17_HOME',
            defaultValue: '',
            description: '可选：JDK17 安装目录，例如 /usr/lib/jvm/java-17-openjdk-amd64'
        )
    }

    environment {
        PROJECT_NAME = 'ai-testops'
        REPORT_DIR = 'target/site/jacoco'
        COVERAGE_DASHBOARD_DIR = 'target/coverage-dashboard'
        JUNIT_REPORT = 'target/surefire-reports/*.xml'
        JACOCO_XML = 'target/site/jacoco/jacoco.xml'
        AI_REPORT = 'ai-risk-report.md'
        UNIT_TEST_OK = 'false'
    }

    options {
        timestamps()
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20', artifactNumToKeepStr: '20'))
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Prepare Tools') {
            steps {
                script {
                    def jdkToolName = params.JDK_TOOL_NAME?.trim()
                    def jdk17Home = params.JDK17_HOME?.trim()

                    if (jdkToolName) {
                        env.JAVA_HOME = tool name: jdkToolName, type: 'hudson.model.JDK'
                    } else if (jdk17Home) {
                        env.JAVA_HOME = jdk17Home
                    } else {
                        def detectedJdk = sh(
                            script: '''
                                set -eu

                                supports_release_17() {
                                    "$1/bin/javac" --release 17 -version >/dev/null 2>&1
                                }

                                find_jdk_home() {
                                    for dir in /usr/lib/jvm/java-17* /usr/lib/jvm/jdk-17* /usr/lib/jvm/temurin-17* /opt/java/openjdk /opt/jdk-17*; do
                                        if [ -x "$dir/bin/javac" ] && supports_release_17 "$dir"; then
                                            echo "$dir"
                                            return 0
                                        fi
                                    done

                                    if command -v javac >/dev/null 2>&1; then
                                        javac_bin=$(readlink -f "$(command -v javac)" 2>/dev/null || command -v javac)
                                        jdk_home=$(dirname "$(dirname "$javac_bin")")
                                        if [ -x "$jdk_home/bin/java" ] && [ -x "$jdk_home/bin/javac" ] && supports_release_17 "$jdk_home"; then
                                            echo "$jdk_home"
                                            return 0
                                        fi
                                    fi

                                    return 1
                                }

                                find_jdk_home || true
                            ''',
                            returnStdout: true
                        ).trim()
                        if (detectedJdk) {
                            env.JAVA_HOME = detectedJdk
                        }
                    }

                    if (env.JAVA_HOME?.trim()) {
                        env.PATH = "${env.JAVA_HOME}/bin:${env.PATH}"
                    }

                    env.MVN_CMD = sh(
                        script: '''
                            if command -v mvn >/dev/null 2>&1; then
                                echo "mvn"
                            else
                                chmod +x ./mvnw
                                echo "./mvnw"
                            fi
                        ''',
                        returnStdout: true
                    ).trim()

                    env.PYTHON_CMD = sh(
                        script: '''
                            if command -v python3 >/dev/null 2>&1; then
                                echo "python3"
                            elif command -v python >/dev/null 2>&1; then
                                echo "python"
                            else
                                echo "ERROR: python3/python not found" >&2
                                exit 1
                            fi
                        ''',
                        returnStdout: true
                    ).trim()

                    echo "Maven command: ${env.MVN_CMD}"
                    echo "Python command: ${env.PYTHON_CMD}"

                    sh '''
                        set -eu
                        if [ -z "${JAVA_HOME:-}" ]; then
                            echo "[ERROR] No JDK home configured or detected."
                            echo "[ERROR] Set JDK_TOOL_NAME to a Jenkins JDK tool, or set JDK17_HOME to a JDK 17+ installation."
                            exit 1
                        fi
                        if [ ! -x "${JAVA_HOME}/bin/java" ] || [ ! -x "${JAVA_HOME}/bin/javac" ]; then
                            echo "[ERROR] JAVA_HOME must point to a full JDK with java and javac: ${JAVA_HOME}"
                            exit 1
                        fi
                        echo "JAVA_HOME=${JAVA_HOME:-}"
                        "${JAVA_HOME}/bin/java" -version
                        "${JAVA_HOME}/bin/javac" -version
                        JAVA_VERSION=$("${JAVA_HOME}/bin/javac" -version 2>&1 | awk '{print $2}')
                        case "$JAVA_VERSION" in
                            1.*) JAVA_MAJOR=$(echo "$JAVA_VERSION" | cut -d. -f2) ;;
                            *) JAVA_MAJOR=$(echo "$JAVA_VERSION" | sed 's/[^0-9].*$//') ;;
                        esac
                        if [ "$JAVA_MAJOR" -lt 17 ]; then
                            echo "[ERROR] This project requires JDK 17+, but current javac is: javac ${JAVA_VERSION}"
                            echo "[ERROR] Install JDK 17+ on the Jenkins node, or set JDK_TOOL_NAME/JDK17_HOME for this job."
                            exit 1
                        fi
                        SMOKE_DIR=target/javac-release-smoke
                        rm -rf "$SMOKE_DIR"
                        mkdir -p "$SMOKE_DIR"
                        printf 'class Release17Smoke {}\\n' > "$SMOKE_DIR/Release17Smoke.java"
                        "${JAVA_HOME}/bin/javac" --release 17 -d "$SMOKE_DIR" "$SMOKE_DIR/Release17Smoke.java"
                        rm -rf "$SMOKE_DIR"
                        ${MVN_CMD} -version
                    '''
                }
            }
        }

        stage('Prepare Diff') {
            steps {
                script {
                    def baseBranch = params.BASE_BRANCH?.trim() ?: 'master'
                    withEnv(["BASE_BRANCH=${baseBranch}"]) {
                        sh '''
                            set -eu

                            echo "Generate git diff against origin/${BASE_BRANCH} ..."
                            git fetch origin "${BASE_BRANCH}" --depth=200 || true

                            if git rev-parse --verify "origin/${BASE_BRANCH}" >/dev/null 2>&1; then
                                git diff "origin/${BASE_BRANCH}...HEAD" --stat > diff-stat.txt || true
                                git diff "origin/${BASE_BRANCH}...HEAD" > diff-full.patch || true
                            elif git rev-parse --verify HEAD~1 >/dev/null 2>&1; then
                                git diff HEAD~1...HEAD --stat > diff-stat.txt || true
                                git diff HEAD~1...HEAD > diff-full.patch || true
                            else
                                : > diff-stat.txt
                                : > diff-full.patch
                            fi

                            echo "Diff stat:"
                            cat diff-stat.txt || true
                        '''
                    }
                }
            }
        }

        stage('Unit Test + JaCoCo Report') {
            steps {
                catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                    sh '${MVN_CMD} -B clean test'
                    script {
                        env.UNIT_TEST_OK = 'true'
                    }
                }
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: "${JUNIT_REPORT}"
                    script {
                        def lineCoverageMin = params.LINE_COVERAGE_MIN?.trim() ?: '0.50'
                        def branchCoverageMin = params.BRANCH_COVERAGE_MIN?.trim() ?: '0.30'
                        sh """
                            ${env.PYTHON_CMD} scripts/coverage_dashboard.py \
                              --project "${PROJECT_NAME}" \
                              --jacoco-xml "${JACOCO_XML}" \
                              --output-dir "${COVERAGE_DASHBOARD_DIR}" \
                              --line-min "${lineCoverageMin}" \
                              --branch-min "${branchCoverageMin}"
                        """
                        if (fileExists("${COVERAGE_DASHBOARD_DIR}/index.html")) {
                            publishHTML(target: [
                                allowMissing: true,
                                alwaysLinkToLastBuild: true,
                                keepAll: true,
                                reportDir: "${COVERAGE_DASHBOARD_DIR}",
                                reportFiles: 'index.html',
                                reportName: 'AI Coverage Dashboard'
                            ])
                        } else {
                            echo "AI coverage dashboard not found, skip dashboard publishing."
                        }

                        if (fileExists("${REPORT_DIR}/index.html")) {
                            publishHTML(target: [
                                allowMissing: true,
                                alwaysLinkToLastBuild: true,
                                keepAll: true,
                                reportDir: "${REPORT_DIR}",
                                reportFiles: 'index.html',
                                reportName: 'JaCoCo Coverage Report'
                            ])
                        } else {
                            echo "JaCoCo HTML report not found, skip HTML publishing."
                        }
                    }
                }
            }
        }

        stage('Coverage Gate') {
            when {
                expression { env.UNIT_TEST_OK == 'true' }
            }
            steps {
                script {
                    def lineCoverageMin = params.LINE_COVERAGE_MIN?.trim() ?: '0.50'
                    def branchCoverageMin = params.BRANCH_COVERAGE_MIN?.trim() ?: '0.30'
                    def coverageCommand = "${env.MVN_CMD} -B jacoco:check@check " +
                        "-Djacoco.line.coverage.minimum=${lineCoverageMin} " +
                        "-Djacoco.branch.coverage.minimum=${branchCoverageMin}"

                    if (params.COVERAGE_GATE_STRICT) {
                        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                            sh coverageCommand
                        }
                    } else {
                        catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                            sh coverageCommand
                        }
                    }
                }
            }
        }

        stage('AI Risk Analysis') {
            steps {
                script {
                    def aiProvider = (params.AI_PROVIDER?.trim() ?: 'MOCK').toUpperCase()
                    if (aiProvider == 'OPENAI_COMPATIBLEE') {
                        echo "AI_PROVIDER=OPENAI_COMPATIBLEE is deprecated; treating it as OPENAI_COMPATIBLE."
                        aiProvider = 'OPENAI_COMPATIBLE'
                    }
                    if (!['MOCK', 'OPENAI_COMPATIBLE'].contains(aiProvider)) {
                        error "Unsupported AI_PROVIDER: ${aiProvider}. Expected MOCK or OPENAI_COMPATIBLE."
                    }
                    def aiApiBase = params.AI_API_BASE?.trim() ?: 'https://api.openai.com'
                    def aiModelName = params.AI_MODEL_NAME?.trim() ?: 'gpt-4o-mini'
                    def aiCredentialsId = params.AI_CREDENTIALS_ID?.trim() ?: 'AI_API_KEY'
                    def failFlag = params.FAIL_ON_AI_ERROR ? '--fail-on-ai-error' : ''
                    def analyzerCommand = """
                        ${env.PYTHON_CMD} scripts/ai_ci_analyzer.py \
                          --project "${PROJECT_NAME}" \
                          --diff-file diff-full.patch \
                          --diff-stat diff-stat.txt \
                          --junit-report "target/surefire-reports" \
                          --jacoco-xml "${JACOCO_XML}" \
                          --output "${AI_REPORT}" \
                          ${failFlag}
                    """
                    def aiEnv = [
                        "AI_PROVIDER=${aiProvider}",
                        "AI_API_BASE=${aiApiBase}",
                        "AI_MODEL_NAME=${aiModelName}",
                        "AI_TEMPERATURE=0.2",
                        "AI_MAX_TOKENS=4096"
                    ]

                    catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                        if (aiProvider == 'MOCK') {
                            withEnv(aiEnv) {
                                sh analyzerCommand
                            }
                        } else {
                            try {
                                withCredentials([string(credentialsId: aiCredentialsId, variable: 'AI_API_KEY')]) {
                                    withEnv(aiEnv) {
                                        sh analyzerCommand
                                    }
                                }
                            } catch (err) {
                                def errorMessage = err.getMessage()
                                if (!errorMessage?.contains('Could not find credentials entry') || params.FAIL_ON_AI_ERROR) {
                                    throw err
                                }

                                echo "Jenkins credential '${aiCredentialsId}' was not found. Falling back to MOCK AI risk analysis because FAIL_ON_AI_ERROR=false."
                                def fallbackAiEnv = aiEnv.collect {
                                    it.startsWith('AI_PROVIDER=') ? 'AI_PROVIDER=MOCK' : it
                                }
                                withEnv(fallbackAiEnv) {
                                    sh analyzerCommand
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: '''
                diff-stat.txt,
                diff-full.patch,
                ai-risk-report.md,
                target/coverage-dashboard/**,
                target/site/jacoco/**,
                target/surefire-reports/**
            ''', allowEmptyArchive: true, fingerprint: true

            script {
                def emailTo = params.EMAIL_TO?.trim()
                if (emailTo) {
                    def emailArgs = [
                        subject: "[${PROJECT_NAME}] AI 测试风险分析：${currentBuild.currentResult} - #${env.BUILD_NUMBER}",
                        to: emailTo,
                        mimeType: 'text/html',
                        attachmentsPattern: 'ai-risk-report.md',
                        saveOutput: true,
                        body: """
                            <h2>${PROJECT_NAME} AI 测试风险分析：${currentBuild.currentResult}</h2>
                            <p><b>构建编号：</b>#${env.BUILD_NUMBER}</p>
                            <p><b>分支：</b>${env.BRANCH_NAME ?: env.GIT_BRANCH}</p>
                            <p><b>构建地址：</b><a href="${env.BUILD_URL}">${env.BUILD_URL}</a></p>
                            <h3>核心报告</h3>
                            <ul>
                                <li><a href="${env.BUILD_URL}artifact/ai-risk-report.md">AI 风险分析报告</a></li>
                                <li><a href="${env.BUILD_URL}AI_20Coverage_20Dashboard/">AI 覆盖率看板</a></li>
                                <li><a href="${env.BUILD_URL}JaCoCo_20Coverage_20Report/">JaCoCo 覆盖率报告</a></li>
                                <li><a href="${env.BUILD_URL}testReport/">JUnit 单测报告</a></li>
                            </ul>
                            <p>如构建失败或 unstable，请优先查看 AI 风险分析报告和覆盖率看板中的必须补测类、低覆盖率类和上线前检查清单。</p>
                        """
                    ]
                    def emailFrom = params.EMAIL_FROM?.trim()
                    if (emailFrom) {
                        emailArgs.from = emailFrom
                        emailArgs.replyTo = emailFrom
                    }
                    try {
                        echo "Sending email notification to ${emailTo}. If it does not arrive, verify Email Extension Plugin and Jenkins global SMTP settings."
                        emailext(emailArgs)
                        echo "Email notification request submitted to Email Extension Plugin."
                    } catch (err) {
                        echo "[WARN] Email notification failed: ${err.getMessage()}"
                        echo "[WARN] EMAIL_TO only configures recipients. Please confirm Email Extension Plugin is installed, Jenkins global SMTP/default sender is configured, and the mailbox did not reject or quarantine the message."
                    }
                } else {
                    echo "EMAIL_TO is empty, skip email notification."
                }
            }
        }
    }
}
