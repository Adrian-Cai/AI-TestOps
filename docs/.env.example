# ============================================
# 数据库配置
# ============================================
DB_URL=jdbc:mariadb://your_remote_host:3306/ai_testops?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=your_username
DB_PASSWORD=your_password
DB_HIKARI_CONNECTION_TIMEOUT=30000
DB_HIKARI_VALIDATION_TIMEOUT=5000
DB_HIKARI_KEEPALIVE_TIME=30000
DB_HIKARI_MAX_LIFETIME=300000

# 服务配置
SERVER_PORT=8080

# 文件上传配置
UPLOAD_MAX_FILE_SIZE=50MB
UPLOAD_MAX_REQUEST_SIZE=60MB
AI_TESTOPS_UPLOAD_DIR=./data/uploads
AI_TESTOPS_FILE_MAX_SIZE=50MB

# 大模型配置。真实 OpenAI-compatible 模型建议保持 JSON 模式开启。
AI_PROVIDER=MOCK
AI_MODEL_CODE=default
AI_MODEL_NAME=mock-requirement-extractor
AI_API_BASE=https://api.openai.com
AI_API_KEY=
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=4096
AI_JSON_MODE=true
